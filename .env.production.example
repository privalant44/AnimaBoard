# Copier vers .env.production (non versionné) pour scripts prod / clone base Supabase.
# Dashboard Supabase → Settings → API

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role_jwt>

# Mot de passe postgres (Settings → Database → Database password)
# Requis pour scripts/supabase-dev-to-prod.ps1 (pg_dump / pg_restore)
SUPABASE_DB_PASSWORD=<postgres_password>

# Optionnel : ref explicite si SUPABASE_URL absente
# SUPABASE_PROJECT_REF=<project-ref>

# Optionnel : URL Postgres complète (remplace SUPABASE_DB_PASSWORD + ref)
# SUPABASE_DB_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres?sslmode=require

# BoondManager, Pennylane, auth… (voir env.example)
