# Port du serveur
PORT=3000

# BoondManager API
BOOND_API_URL=https://ui.boondmanager.com/api
BOOND_EMAIL=your_email@example.com
BOOND_PASSWORD=your_password_here

# Pennylane API
PENNYLANE_API_URL=https://api.pennylane.io
PENNYLANE_API_KEY=your_api_key_here

# Stockage KV (Redis) - optionnel en local (sinon cache mémoire)
# Créer une base Upstash Redis : voir VERCEL_KV_SETUP.md
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# Environnement
NODE_ENV=development
