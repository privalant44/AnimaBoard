# Port du serveur
PORT=3000

# BoondManager API — accès par email / mot de passe (Basic Auth)
# Le mot de passe peut être en clair ou chiffré (BOOND_PASSWORD_ENC)
BOOND_API_URL=https://ui.boondmanager.com/api
BOOND_EMAIL=your_email@example.com
BOOND_PASSWORD=your_password_here

# Mot de passe chiffré (optionnel) : node scripts/encrypt-env.js "votre_mot_de_passe"
# Puis mettre la sortie dans BOOND_PASSWORD_ENC et définir ANIMA_SECRET_KEY
# ANIMA_SECRET_KEY=une_phrase_secrete_longue
# BOOND_PASSWORD_ENC=...

# Pennylane API
PENNYLANE_API_URL=https://api.pennylane.io
PENNYLANE_API_KEY=your_api_key_here

# Upstash Redis — dev local uniquement (stockage des syncs)
# En prod Vercel : ne pas ajouter ; Vercel utilise son propre KV (variables injectées par le projet)
# Créer une base sur https://console.upstash.com puis copier URL et token
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

# Environnement
NODE_ENV=development
