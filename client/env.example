# Variables exposées au bundle React (préfixe REACT_APP_ obligatoire avec CRA).
# Copier vers .env.development ou .env.local selon votre flux.

REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Authentification Microsoft (voir docs/AUTH_MICROSOFT.md)
# REACT_APP_AUTH_ENABLED=true
# REACT_APP_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# REACT_APP_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
