# Port du serveur
PORT=3000

# BoondManager API — accès par email / mot de passe (Basic Auth)
# Le mot de passe peut être en clair ou chiffré (BOOND_PASSWORD_ENC)
BOOND_API_URL=https://ui.boondmanager.com/api
BOOND_EMAIL=your_email@example.com
BOOND_PASSWORD=your_password_here

# Mot de passe chiffré (optionnel) : node scripts/encrypt-env.js "votre_mot_de_passe"
# Puis mettre la sortie dans BOOND_PASSWORD_ENC et définir ANIMA_SECRET_KEY
# ANIMA_SECRET_KEY=une_phrase_secrete_longue
# BOOND_PASSWORD_ENC=...

# Pennylane API v2 — P&L par défaut via GET /ledger_entry_lines (lignes sur la période, comme un export PowerShell).
# Ancien flux pièces + sous-ressource : PENNYLANE_PL_SOURCE=ledger_entries
# Docs listes : https://pennylane.readme.io/reference/getledgerentries.md (écritures) ; index des lignes = /ledger_entry_lines
# Pagination cursor + limit (1–100). Scopes : ledger_entries:readonly + ledger_accounts:readonly
# PENNYLANE_PL_SOURCE=ledger_entry_lines
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2
PENNYLANE_API_KEY=your_api_token_here
# Comportement API 2026 (pagination curseur, etc.). Désactiver : PENNYLANE_USE_2026_API_CHANGES=false
# PENNYLANE_USE_2026_API_CHANGES=true
# Tri optionnel sur la liste (ex. date ou -date). Voir paramètre sort de l’endpoint.
# PENNYLANE_LEDGER_SORT=date
# Filtrer les pièces après chargement (le filtre API officiel ne couvre que date, id, journal_id).
# Ex. posted pour exclure les brouillons une fois les entrées ramenées.
# PENNYLANE_LEDGER_STATUS=posted
# Si aucune écriture ne revient, essayer : PENNYLANE_LEDGER_DATE_GTE=gte et PENNYLANE_LEDGER_DATE_LTE=lte
# PENNYLANE_PAGE_LIMIT=100
# Délai entre pages Pennylane (ms). Baisse possible si pas de 429 (ex. 120).
# PENNYLANE_RATE_DELAY_MS=260
# Parallélisme pour GET /ledger_accounts/:id lors de la résolution des numéros (lots + délai entre lots). Réduisez si 429.
# PENNYLANE_ACCOUNT_FETCH_CONCURRENCY=8
# Cache serveur du compte de résultat par année (ms), évite tout rappel Pennylane pendant ce délai. 0 = désactivé.
# PENNYLANE_INCOME_CACHE_MS=90000
# Plan comptable réduit (ex. un seul compte 6 et un seul 7) — préfixes Pennylane, virgules si plusieurs :
# PENNYLANE_PL_CHARGES_PREFIXES=60100000
# PENNYLANE_PL_PRODUITS_PREFIXES=70100000

# Supabase — stockage métier (lib/db.js, lib/supabaseClient.js)
# Cloud : URL du dashboard (Settings → API) + service_role JWT.
# Local (supabase start) : copier « Project URL » et la clé Secret depuis `npx supabase status`.
# Attention : si supabase/config.toml utilise un autre port API (ex. 55221 car Windows réserve 543xx),
# SUPABASE_URL doit être exactement cette URL, sinon les syncs échouent (fetch failed) et les tables restent vides.
# Local par défaut : http://127.0.0.1:55221 (HTTP, pas de certificat). Si [api.tls] enabled = true dans
# supabase/config.toml (HTTPS auto-signé), ajoutez le certificat Supabase à NODE_EXTRA_CA_CERTS (voir ci-dessous).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# TLS / certificats HTTPS (BoondManager, Pennylane, Supabase HTTPS local, proxy d’entreprise)
# Erreur Node « unable to verify the first certificate » / UNABLE_TO_VERIFY_LEAF_SIGNATURE :
#   cause fréquente = proxy ou antivirus qui intercepte le HTTPS (certificat d’entreprise non reconnu par Node).
# Solution recommandée (dev et prod) : exporter le certificat racine du proxy et pointer :
# NODE_EXTRA_CA_CERTS=C:\chemin\vers\corporate-root-ca.pem
#
# Contournement DEV UNIQUEMENT (jamais en production) si vous ne pouvez pas installer le CA :
# DEV_INSECURE_TLS=1
# (active rejectUnauthorized=false pour axios côté serveur ; voir lib/tlsConfig.js)

# Microsoft Entra ID (authentification utilisateurs — voir docs/AUTH_MICROSOFT.md)
# AUTH_ENABLED=true
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Restreindre aux domaines e-mail (virgules) : animaneo.fr,autredomaine.com
# AUTH_ALLOWED_EMAIL_DOMAINS=animaneo.fr
# Rôle par défaut si l'e-mail n'est pas dans app_user_roles : consultation | manager | commercial | admin
# AUTH_DEFAULT_ROLE=consultation
# Surcharges sans SQL (virgules) : email@domaine.fr=manager,autre@domaine.fr=commercial
# AUTH_ROLE_OVERRIDES=

# Compte administrateur local (connexion identifiant / mot de passe)
# LOCAL_ADMIN_USERNAME=administrateur
# Hash scrypt base64 (générer : node scripts/hash-local-admin-password.js "VotreMotDePasse")
# Valeur ci-dessous = mot de passe dev documenté dans AUTH_MICROSOFT.md (à changer en prod)
# LOCAL_ADMIN_PASSWORD_HASH=tyB2mi129FbXRxKk++CinZP3kd7AzWurJm26azblWY54Mp2TyABjA6muZT8NyaYsP5wGkOZaUlOtLu8u5NhnbA==
# LOCAL_ADMIN_EMAIL=admin@animaneo.local
# Secret pour signer les JWT locaux (obligatoire en production)
# LOCAL_AUTH_JWT_SECRET=changez-moi-avec-une-longue-chaine-aleatoire
# LOCAL_AUTH_JWT_EXPIRES=8h

# Environnement
NODE_ENV=development
